Options -MultiViews
RewriteEngine On
RewriteBase /

# Let existing files and directories be served directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback for BrowserRouter routes on Timeweb shared hosting.
RewriteRule ^ index.html [L]
